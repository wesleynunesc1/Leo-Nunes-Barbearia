# =============================================================================
# LÉO NUNES BARBEARIA — VARIÁVEIS DE AMBIENTE & INTEGRAÇÃO WIX BOOKINGS
# =============================================================================
#
# Para conectar a agenda do site ao Wix Bookings oficial do proprietário,
# preencha as variáveis abaixo em um arquivo `.env.local` na raiz do projeto.
#
# ATENÇÃO: NUNCA compartilhe suas chaves de API nem faça commit de .env.local!
#

# -----------------------------------------------------------------------------
# 1. CREDENCIAIS WIX HEADLESS / DEVELOPERS API
# -----------------------------------------------------------------------------
# Gerar em: Wix Studio / Wix Developers Console -> Apps -> Permissions / API Keys
# Permissões necessárias:
# - wix.bookings.read (consultar serviços, profissionais e slots)
# - wix.bookings.write (Bookings Writer V2 — criar agendamentos)
# - wix.members.read (opcional: consultar membros)
WIX_API_KEY=""

# ID do site no Wix (localizado na URL do painel administrativo ou nas configurações do site)
WIX_SITE_ID=""

# ID da conta Wix (Account ID do proprietário)
WIX_ACCOUNT_ID=""

# Wix Headless OAuth Client ID
WIX_CLIENT_ID=""
NEXT_PUBLIC_WIX_CLIENT_ID=""

# Controle de homologação (false = dry-run seguro, true = criação real no Wix)
ENABLE_REAL_WIX_BOOKINGS=false

# -----------------------------------------------------------------------------
# 2. UPSTASH REDIS (INJETADO AUTOMATICAMENTE NA VERCEL PELA INTEGRAÇÃO)
# -----------------------------------------------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# -----------------------------------------------------------------------------
# 3. CONFIGURAÇÕES REGIONAIS & FUSO HORÁRIO
# -----------------------------------------------------------------------------
# Fuso horário oficial de Pacajus - Ceará
NEXT_PUBLIC_TIMEZONE="America/Fortaleza"

# Número de WhatsApp oficial para suporte e atendimento manual de fallback
NEXT_PUBLIC_WHATSAPP_NUMBER="5585992227064"
